# Copy to .env and fill in. Never commit .env.

# Required for bookings
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
# GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json
# Or set GOOGLE_SERVICE_ACCOUNT_JSON with the full JSON (e.g. on Render)

# SATURDAY_OFF: weekly break Fri 9:00 PM IST → Sat 9:00 PM IST (no online bookings). Opens Sat 9 PM for Sunday’s sheet.
# When unset or false: normal 9 PM daily cycle every day.
# SATURDAY_OFF=true

# Optional
# MAX_BOOKINGS_PER_DAY=18
# USE_DAILY_SHEETS=true
# BOOKING_ALWAYS_OPEN=true
# GOOGLE_FORM_EMBED_URL=https://docs.google.com/forms/d/...
# SEND_BOOKING_EMAIL=true
# SENDGRID_API_KEY=...
# TEST_SATURDAY_9PM=true
